{
  "name": "@adaptive-ds/solid-ui",
  "version": "0.20.0",
  "scripts": {
    "dev": "bun run vite:dev",
    "build": "bun run build:site",
    "build:site": "bun run vite:build",
    "build:lib": "clear ; rm -rf ./dist ; vite build --config vite.config.lib.ts",
    "ts:build": "rm -rf ./export ; tsc -p ./tsconfig.lib.json",
    "compile": "bun check",
    "vite:dev": "nice -5 vite dev --debug hmr",
    "vite:build": "nice -15 vite build",
    "vite:deploy": "bun run vite:build && bun run upload && bun run tag:deployed",
    "rsbuild:dev": "nice -5 rsbuild dev",
    "rsbuild:build": "nice -15 rsbuild build",
    "rsbuild:deploy": "bun run rsbuild:build && bun run upload && bun run tag:deployed",
    "deploy": "bash ./ops/deploy.bash",
    "upload": "bash ./ops/upload.bash",
    "tag:deployed": "git branch -f deployed",
    "release": "bash ./ops/release.sh",
    "generateDemoList": "bun run ./src/app/demos/generateDemoList.cli.ts",
    "generateIndexAgents": "bun run ./src/app/generateIndexAgents.cli.ts",
    "update": "nice -15 bun x npm-check-updates -u && bun i",
    "update:commit": "bun x npm-check-updates -u && bun i && git add package.json && bun check && git commit -m \"chore(deps): update dependencies\" && git push",
    "format": "biome format --write src ui package.json tsconfig.json tsconfig.lib.json biome.json",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/mdi": "^0.1.2",
    "@adaptive-ds/utils": "^0.12.0",
    "@solid-primitives/keyed": "^3.0.0",
    "@solid-primitives/scheduled": "^2.0.0",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "cn": "^0.2.4",
    "dayjs": "^1.11.19",
    "solid-js": "^2.0.1",
    "valibot": "^1.1.0",
    "@corvu-next/dialog": "^0.1.5",
    "@corvu-next/popover": "^0.1.5",
    "@solidjs/web": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@rsbuild/core": "^2.0.12",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-solid": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "@tanstack/solid-start": "2.0.0-rc.10",
    "@types/bun": "latest",
    "glob": "^13.0.6",
    "image-size": "^2.0.2",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "wrangler": "^4.100.0",
    "@solidjs/vite-plugin": "^3.0.1"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*.jsx": "./src/*.tsx",
    "#src/*": "./src/*",
    "#ui/*.js": "./ui/*.ts",
    "#ui/*.jsx": "./ui/*.tsx",
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/david1gp/solid-ui",
  "description": "A library of reusable UI components for Solid.js projects. Built with TypeScript, Tailwind CSS, and Solid.js. Components are designed to be accessible, customizable, and easy to integrate.",
  "keywords": [
    "solid",
    "solidjs",
    "tailwind",
    "tailwindcss",
    "components",
    "ui-components",
    "web-development",
    "frontend",
    "typescript"
  ],
  "repository": {
    "url": "git+https://github.com/david1gp/solid-ui.git"
  },
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "solid-js": "^2.0.1"
  },
  "patchedDependencies": {
    "@corvu-next/focus-trap@0.1.4": "patches/@corvu-next%2Ffocus-trap@0.1.4.patch"
  }
}
